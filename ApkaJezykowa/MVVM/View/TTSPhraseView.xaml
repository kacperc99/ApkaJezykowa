<UserControl x:Class="ApkaJezykowa.MVVM.View.TTSPhraseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ApkaJezykowa.MVVM.View"
             mc:Ignorable="d" >
    <Grid Background="DimGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Task, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Foreground="Black" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="36" Background="DimGray"></TextBlock>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding Colour}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" FontSize="24" Background="DimGray" Visibility="{Binding Phrase_Switch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></TextBlock>
            <Button Height="200" Width="200" Background="Transparent" Visibility="{Binding Button_Switch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                BorderThickness="0" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource NoMouseOver}"
                  Command="{Binding Play}">
                <StackPanel>
                    <Image Source="pack://application:,,,/ApkaJezykowa;component/Images/listen.png"  VerticalAlignment="Bottom" Margin="0,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
        <TextBox Grid.Row="2" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  Background="DimGray" BorderThickness="0,0,0,2" BorderBrush="Black" Foreground="Black" Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" IsReadOnly="{Binding Answer_Read_Only, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        <Button Grid.Row="2" x:Name="Register_Voice" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" Content="Speak" Width="150" Height="50" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Command="{Binding Speak}" Margin="10,0,0,10" Visibility="{Binding Speak_Switch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"></Button>
        <Button Grid.Row="3" x:Name="Leave" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" Content="Powrót" Width="150" Height="50" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Command="{Binding TTSPhraseUpdateViewCommand}" Margin="10,0,0,10"></Button>
        <Button Grid.Row="3" x:Name="Check" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" Content="{Binding Next_Button_Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="150" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Command="{Binding Check}" Margin="0,0,10,10"></Button>
        <ContentControl Grid.RowSpan="4" Content="{Binding SelectedViewModel}"/>
    </Grid>
</UserControl>
