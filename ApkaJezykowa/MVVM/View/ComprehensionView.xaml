<UserControl x:Class="ApkaJezykowa.MVVM.View.ComprehensionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ApkaJezykowa.MVVM.View"
             mc:Ignorable="d">
    <Grid Background="DimGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Text_Title}" Foreground="Black" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="36" Background="DimGray"></TextBlock>
        <Image Grid.Row="1" Source="{Binding Image}"></Image>
        <StackPanel Grid.Row="2">
            <TextBlock Width="Auto" FontSize="24" Foreground="Black" TextWrapping="Wrap">
                <Run Text="{Binding LessonText}"/>
            </TextBlock>
            <ListBox Height="Auto" Width="Auto" 
                     ItemsSource="{Binding VocabList}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     BorderBrush="Transparent"
                         Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" IsItemsHost="True" 
               HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,10,0,10"
                                   Style="{StaticResource Font_Style}"
                                   HorizontalAlignment="Left"
                                   Foreground="Black">
                            <Run Text="{Binding Word}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding Translated_Word}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2">
            <Button x:Name="Leave" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" Content="Return" Width="150" Height="50" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Command="{Binding ComprehensionUpdateViewCommand}" CommandParameter="ReturnToMenu" Margin="10,0,0,10"></Button>
            <Button x:Name="Next" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" Content="Next" Width="150" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Command="{Binding ComprehensionUpdateViewCommand}" CommandParameter="GoToQuestions" Margin="0,0,10,10" IsVisibleChanged="{Binding ButtonSwitch}"></Button>
            </Grid>
        </StackPanel>
        <ContentControl Grid.RowSpan="3" Content="{Binding SelectedViewModel}"/>
    </Grid>
</UserControl>
